+        private static bool PhisAgree(BasicBlock target, BasicBlock a, BasicBlock b)
+        {
+            if (target == null)
+            {
+                return false;
+            }
+
+            foreach (INode node in target.Operations)
+            {
+                if (node is not PhiNode phi)
+                {
+                    continue;
+                }
+
+                Operand fromA = null;
+                Operand fromB = null;
+
+                for (int index = 0; index < phi.SourcesCount; index++)
+                {
+                    BasicBlock source = phi.GetBlock(index);
+
+                    if (source == a)
+                    {
+                        fromA = phi.GetSource(index);
+                    }
+                    else if (source == b)
+                    {
+                        fromB = phi.GetSource(index);
+                    }
+                }
+
+                if (!SameValue(fromA, fromB))
+                {
+                    return false;
+                }
+            }
+
+            return true;
+        }
+
+        private static bool SameValue(Operand x, Operand y)
+        {
+            if (x == y)
+            {
+                return true;
+            }
+
+            return x != null && y != null && x.Type == OperandType.Constant && y.Type == OperandType.Constant && x.Value == y.Value;
